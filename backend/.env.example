# Copy this file to .env and adjust as needed. All defaults work with zero setup.

# Local SQLite by default. Switch to Postgres for production / docker-compose:
# DATABASE_URL=postgresql://cmac:cmac@localhost:5432/cmac
DATABASE_URL=sqlite:///./cmac.db

# Alert thresholds
CROWD_ALERT_THRESHOLD=40
MAINTENANCE_ANOMALY_THRESHOLD=-0.15
DELAY_ALERT_THRESHOLD_MIN=15

# Notification channel: console (default, no keys needed) | twilio
NOTIFY_CHANNEL=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
